# Saytın real domeni (canonical, Open Graph, sitemap və robots.txt üçün). Gizli deyil.
NEXT_PUBLIC_SITE_URL=https://nebishirimbot.vercel.app

# Web app-in backend-i: NeBishirimBot FastAPI deployment-i (o, /web/v1 API-ni təqdim edir).
# Yalnız serverdə oxunur, brauzerə getmir.
BOT_API_URL=https://your-bot-deployment.vercel.app

# Bot backend-dəki INTERNAL_WEB_API_SECRET ilə eyni dəyər (ən azı 32 simvol).
# Yaratmaq üçün: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_WEB_API_SECRET=
